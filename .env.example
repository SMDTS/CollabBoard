# CollabBoard Environment Configuration
# Copy this file to `.env` in the root directory to set your environment variables.

# MongoDB Connection
# Default (local Docker mongo container):
# MONGODB_URI=mongodb://mongo:27017/flowty
#
# For MongoDB Atlas (Cloud Database), uncomment and fill in your connection string:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/flowty?retryWrites=true&w=majority

# Secret key for JWT session tokens (change in production)
JWT_SECRET=dev-secret-change-me-in-a-real-deployment

# SMTP Configuration (Optional - for sending actual emails)
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=your_user
# SMTP_PASS=your_pass
# EMAIL_FROM=Flowty <no-reply@flowty.dev>
